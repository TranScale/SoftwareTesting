    },
    {
      "name": "05 Trending And Filters",
      "item": [
        {
          "name": "TC-API-CAT-017 Trending endpoint returns active trending categories and products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/catalog/trending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Trending payload returns categories and products arrays', function () {",
                  "    pm.expect(json.categories).to.be.an('array');",
                  "    pm.expect(json.products).to.be.an('array');",
                  "    pm.expect(json.categories.length).to.be.at.most(8);",
                  "    pm.expect(json.products.length).to.be.at.most(8);",
                  "    json.products.forEach(function (item) { pm.expect(item.isTrending).to.eql(true); });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-API-CAT-018 Filters endpoint returns active categories and brands with product counts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/catalog/filters"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Filters payload contains category and brand lookups', function () {",
                  "    pm.expect(json.categories).to.be.an('array').that.is.not.empty;",
                  "    pm.expect(json.brands).to.be.an('array').that.is.not.empty;",
                  "    json.categories.forEach(function (entry) {",
                  "        pm.expect(entry).to.have.property('id');",
                  "        pm.expect(entry).to.have.property('name');",
                  "        pm.expect(entry).to.have.property('productCount');",
                  "    });",
                  "    json.brands.forEach(function (entry) {",
                  "        pm.expect(entry).to.have.property('id');",
                  "        pm.expect(entry).to.have.property('name');",
                  "        pm.expect(entry).to.have.property('productCount');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
