    },
    {
      "name": "04 Product Detail",
      "item": [
        {
          "name": "TC-API-CAT-014 Catalog product detail endpoint returns expected payload for valid active product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/catalog/products/{{sampleProductId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const sampleProductId = Number(pm.environment.get('sampleProductId'));",
                  "pm.test('Detail payload contains the expected schema', function () {",
                  "    pm.expect(json.id).to.eql(sampleProductId);",
                  "    pm.expect(json.sku).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.name).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.salePrice).to.be.a('number');",
                  "    pm.expect(json.stockOnHand).to.be.a('number');",
                  "    pm.expect(json.reorderLevel).to.be.a('number');",
                  "    pm.expect(json.isTrending).to.be.a('boolean');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-API-CAT-015 Catalog product detail endpoint rejects id less than or equal to zero",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/catalog/products/0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "const json = pm.response.json();",
                  "pm.test('Validation payload targets id lower bound', function () {",
                  "    pm.expect(json.code).to.eql('validation_error');",
                  "    pm.expect(json.target).to.eql('id');",
                  "    pm.expect(json.message).to.eql('Id must be greater than 0.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-API-CAT-016 Catalog product detail endpoint returns not_found for unknown active product id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/catalog/products/{{unknownProductId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
                  "const json = pm.response.json();",
                  "pm.test('Not found payload targets id', function () {",
                  "    pm.expect(json.code).to.eql('not_found');",
                  "    pm.expect(json.target).to.eql('id');",
                  "    pm.expect(json.message).to.eql('Product not found.');",
                  "});"
